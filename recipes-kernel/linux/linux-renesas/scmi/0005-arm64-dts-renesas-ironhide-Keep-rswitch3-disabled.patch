From 59126c1e14866606959fc5e8824f04a6f6080640 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Le=20Goffic?= <legoffic.clement@gmail.com>
Date: Tue, 1 Sep 2026 11:46:14 +0200
Subject: [PATCH 5/6] arm64: dts: renesas: ironhide: Keep rswitch3 disabled
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The driver first register access to the switch hangs the core forever.
The block is off the bus during Linux boot and there is no bus timeout,
so a bad access never aborts.
Wiring and de-asserting the SCMI reset domain was tried and did not
help, so the root cause is not the reset.
Keep the node disabled until the block is proven to stay on the bus.
Suspects are the core functional clock or an SCMI clock or power
transition during clk and genpd init.

Co-developed-by: Claude Fable 5 <noreply@anthropic.com>
Signed-off-by: Clément Le Goffic <clegoffic@baylibre.com>
---
 arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
index 4d2981748ba5..bfeff7557d94 100644
--- a/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
+++ b/arch/arm64/boot/dts/renesas/r8a78000-ironhide.dts
@@ -579,7 +579,16 @@ &rsw3_clk {
 };
 
 &rswitch3 {
-	status = "okay";
+	/*
+	 * Kept disabled: the driver's first register access to the switch
+	 * hangs the core forever (the block is off the bus during Linux boot,
+	 * and there is no bus timeout, so a bad access never aborts). Wiring
+	 * and de-asserting the SCMI reset domain was tried and did NOT help, so
+	 * the root cause is not the reset. Re-enable only once the block is
+	 * proven to stay on the bus (suspect the core functional clock, or an
+	 * SCMI clock/power transition during clk/genpd init).
+	 */
+	status = "disabled";
 	pinctrl-0 = <&eth25g2_pins>, <&ethes0_pins>;
 	pinctrl-names = "default";
 
-- 
