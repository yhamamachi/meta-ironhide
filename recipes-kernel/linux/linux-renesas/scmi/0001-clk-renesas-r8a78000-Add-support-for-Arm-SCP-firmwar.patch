From 9fc3b77c426c1bfc30792caab8fd5b6fa132e42d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Le=20Goffic?= <legoffic.clement@gmail.com>
Date: Mon, 24 Aug 2026 19:19:56 +0200
Subject: [PATCH 1/6] clk: renesas: r8a78000: Add support for Arm SCP-firmware
 2.16.0
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Arm SCP-firmware server reports vendor "Renesas", sub-vendor
"Renesas" and implementation version 0x02100000.
Its SCMI clock numbering was compared against the SDK 4.32 sources and
found identical for all 1697 clocks, so it shares the map used since
SDK 4.31.
The sub-vendor comparison is dropped because it only re-checks what the
implementation version already selects.

Co-developed-by: Claude Fable 5 <noreply@anthropic.com>
Signed-off-by: Clément Le Goffic <clegoffic@baylibre.com>
---
 drivers/clk/renesas/r8a78000-cpg.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/renesas/r8a78000-cpg.c b/drivers/clk/renesas/r8a78000-cpg.c
index fceedf071046..af5e33575ac6 100644
--- a/drivers/clk/renesas/r8a78000-cpg.c
+++ b/drivers/clk/renesas/r8a78000-cpg.c
@@ -275,8 +275,7 @@ static int r8a78000_cpg_probe(struct platform_device *pdev)
 		goto fallback;
 	}
 
-	if (strcmp(version.vendor_id, "Renesas") ||
-	    strcmp(version.sub_vendor_id, "None")) {
+	if (strcmp(version.vendor_id, "Renesas")) {
 		dev_warn(dev, "Unsupported SCMI firmware %s/%s\n",
 			 version.vendor_id, version.sub_vendor_id);
 		goto fallback;
@@ -334,6 +333,7 @@ static const struct fw_map r8a78000_cpg_fw_map[] = {
 	{ 0x010d0000, r8a78000_cpg_fw_4_31_0 },	/* SCP FW SDKv4.31.0 */
 	{ 0x010e0000, r8a78000_cpg_fw_4_31_0 },	/* SCP FW SDKv4.32.0 */
 	{ 0x01100000, r8a78000_cpg_fw_4_31_0 },	/* SCP FW SDKv4.36.0 */
+	{ 0x02100000, r8a78000_cpg_fw_4_31_0 },	/* Arm SCP-firmware 2.16.0 */
 	{ /* sentinel */ }
 };
 
-- 
