From 4c86499dc0afb7c72a774c80542dd9279c433da4 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Le=20Goffic?= <clegoffic@baylibre.com>
Date: Mon, 24 Aug 2026 17:44:33 +0200
Subject: [PATCH 2/5] firmware: scmi: Poll the shared buffer for the response
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The MFIS mailbox driver only rings the doorbell.
It has no receive operation, and mbox_recv() returns straight away when a
driver does not provide one.
The mailbox transport then reads the shared buffer at once and finds the
channel still taken by the request it just sent, so the transfer fails with
"Channel unexpectedly busy".

Whether this works is pure timing.
A fast server frees the channel during the one millisecond delay that
follows the doorbell write, and the read then succeeds by luck.
A slower one, such as a debug build of the system control processor, does
not, and every SCMI call made during driver model init fails.

Wait for the server to set the free bit in the channel status word before
reading the response, bounded by the timeout the channel already carries.
This is what the Linux driver does on channels that have no completion
interrupt.

Co-developed-by: Claude Fable 5 <noreply@anthropic.com>
Signed-off-by: Clément Le Goffic <clegoffic@baylibre.com>
---
 drivers/firmware/scmi/mailbox_agent.c |  8 ++++++++
 drivers/firmware/scmi/smt.c           | 22 ++++++++++++++++++++++
 drivers/firmware/scmi/smt.h           |  9 +++++++++
 3 files changed, 39 insertions(+)

diff --git a/drivers/firmware/scmi/mailbox_agent.c b/drivers/firmware/scmi/mailbox_agent.c
index cda94565de5..ada8c05db13 100644
--- a/drivers/firmware/scmi/mailbox_agent.c
+++ b/drivers/firmware/scmi/mailbox_agent.c
@@ -63,6 +63,14 @@ static int scmi_mbox_process_msg(struct udevice *dev,
 		goto out;
 	}
 
+	/*
+	 * A mailbox driver with no receive operation returns at once, so the
+	 * shared buffer is the only place telling when the response landed.
+	 */
+	ret = scmi_wait_for_smt_channel(dev, &chan->smt, chan->timeout_us);
+	if (ret)
+		goto out;
+
 	ret = scmi_read_resp_from_smt(dev, &chan->smt, msg);
 
 out:
diff --git a/drivers/firmware/scmi/smt.c b/drivers/firmware/scmi/smt.c
index cd1c0801f72..ad6c15f550a 100644
--- a/drivers/firmware/scmi/smt.c
+++ b/drivers/firmware/scmi/smt.c
@@ -16,6 +16,7 @@
 #include <dm/ofnode.h>
 #include <linux/compat.h>
 #include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/ioport.h>
 
 #include "smt.h"
@@ -104,6 +105,27 @@ int scmi_write_msg_to_smt(struct udevice *dev, struct scmi_smt *smt,
 	return 0;
 }
 
+/**
+ * Wait for the server to release the SMT shared buffer @smt, which tells the
+ * response is in place.
+ * Return 0 on success and with a negative errno in case of error.
+ */
+int scmi_wait_for_smt_channel(struct udevice *dev, struct scmi_smt *smt,
+			      ulong timeout_us)
+{
+	struct scmi_smt_header *hdr = (void *)smt->buf;
+	u32 status;
+	int ret;
+
+	ret = readx_poll_timeout(ioread32, &hdr->channel_status, status,
+				 status & SCMI_SHMEM_CHAN_STAT_CHANNEL_FREE,
+				 timeout_us);
+	if (ret)
+		dev_err(dev, "Channel still busy after %luus\n", timeout_us);
+
+	return ret;
+}
+
 /**
  * Read SCMI message from a SMT shared buffer @smt and copy it into @msg.
  * Return 0 on success and with a negative errno in case of error.
diff --git a/drivers/firmware/scmi/smt.h b/drivers/firmware/scmi/smt.h
index 9d669a6c922..9e7eddcdc78 100644
--- a/drivers/firmware/scmi/smt.h
+++ b/drivers/firmware/scmi/smt.h
@@ -95,6 +95,15 @@ int scmi_dt_get_smt_buffer(struct udevice *dev, struct scmi_smt *smt);
 int scmi_write_msg_to_smt(struct udevice *dev, struct scmi_smt *smt,
 			  struct scmi_msg *msg);
 
+/*
+ * Wait for the server to release a SMT shared memory
+ * @dev: SCMI device
+ * @smt: Reference to shared memory using SMT header
+ * @timeout_us: Time to wait for, in microseconds
+ */
+int scmi_wait_for_smt_channel(struct udevice *dev, struct scmi_smt *smt,
+			      ulong timeout_us);
+
 /*
  * Read SCMI message from a SMT shared memory
  * @dev: SCMI device
-- 
