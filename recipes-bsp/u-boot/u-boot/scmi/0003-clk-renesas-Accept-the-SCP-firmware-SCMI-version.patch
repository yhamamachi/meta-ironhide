From 1c8d34ed5ac1f0e7455a47f2b0458e89a6b898f1 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Le=20Goffic?= <clegoffic@baylibre.com>
Date: Mon, 24 Aug 2026 18:29:05 +0200
Subject: [PATCH 3/5] clk: renesas: Accept the SCP-firmware SCMI version
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Gen5 clock driver picks its DT to SCMI identifier map from the
implementation version reported by the SCMI base protocol.
Only the Renesas SDK releases are listed, so every other server is
turned away with "Unsupported SCMI base protocol version".

The Arm SCP-firmware server reports 0x02100000.
Its identifier numbering was compared against the SDK 4.32 sources and
found identical for all 1697 clocks.
It can therefore share the map already used for SDK 4.32 instead of
carrying a copy of it.

Without this entry the lookup fails for every clock, which leaves the
MMC host without a clock and the ethernet controller unusable.

Co-developed-by: Claude Fable 5 <noreply@anthropic.com>
Signed-off-by: Clément Le Goffic <clegoffic@baylibre.com>
---
 drivers/clk/renesas/r8a78000-cpg.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/renesas/r8a78000-cpg.c b/drivers/clk/renesas/r8a78000-cpg.c
index 67d820bbde8..f7877951f72 100644
--- a/drivers/clk/renesas/r8a78000-cpg.c
+++ b/drivers/clk/renesas/r8a78000-cpg.c
@@ -106,6 +106,7 @@ struct clk_map_in {
 #define GEN5_SCMI_SDK_4_31		0x010d0000
 #define GEN5_SCMI_SDK_4_32		0x010e0000
 #define GEN5_SCMI_SDK_4_36		0x01100000
+#define GEN5_SCMI_SCP_FW_2_16		0x02100000
 
 static const struct clk_map_in gen5_clk_map_dt_sdk_4_28[] = {
 	{ SCP_CLOCK_ID_MDLC_UFS0, 202 },
@@ -188,7 +189,8 @@ static int gen5_clk_of_xlate(struct clk *clk, struct ofnode_phandle_args *args)
 		map_size = ARRAY_SIZE(gen5_clk_map_dt_sdk_4_28);
 	} else if (priv->basever == GEN5_SCMI_SDK_4_31 ||
 		   priv->basever == GEN5_SCMI_SDK_4_32 ||
-		   priv->basever == GEN5_SCMI_SDK_4_36) {
+		   priv->basever == GEN5_SCMI_SDK_4_36 ||
+		   priv->basever == GEN5_SCMI_SCP_FW_2_16) {
 		map = gen5_clk_map_dt_sdk_4_31;
 		map_size = ARRAY_SIZE(gen5_clk_map_dt_sdk_4_31);
 	} else {
-- 
