rsip_ipl_scp_ep=0x8c180000
rsip_ipl_linux_ep=0x91000000

_flash_ipl_ufs=setexpr blk_cnt ${filesize} + 0xfff && setexpr blk_cnt ${blk_cnt} / 0x1000 && scsi write ${loadaddr} ${writeaddr} ${blk_cnt}
flash_ipl_scp=setenv writeaddr 0xd00  && tftp ${loadaddr} x5h_wb/rcar5-bl2.bin && run _flash_ipl_ufs
flash_ipl_bl31=setenv writeaddr 0x5000 && tftp ${loadaddr} x5h_wb/bl31-ironhide.bin && run _flash_ipl_ufs
flash_ipl_tee=setenv writeaddr 0x5200 && tftp ${loadaddr} x5h_wb/apu-tee-ironhide.bin && run _flash_ipl_ufs
flash_ipl_cr52=setenv writeaddr 0xe00  && tftp ${loadaddr} x5h_wb/zephyr.bin && run _flash_ipl_ufs
flash_ipl_uboot=setenv writeaddr 0x7200 && tftp ${loadaddr} x5h_wb/u-boot-ironhide.bin && run _flash_ipl_ufs
flash_ipls=setenv loadaddr 0x60000000; run flash_ipl_scp ; run flash_ipl_bl31 ; run flash_ipl_tee ; run flash_ipl_uboot

_update_ipl_hf=protect off ${flash_addr} +${filesize}; erase ${flash_addr} +${filesize}; cp.b ${loadaddr} ${flash_addr} ${filesize}; cmp.b ${loadaddr} ${flash_addr} ${filesize}
update_uboot=setenv flash_addr 0x34040000; tftp ${loadaddr} x5h_wb/u-boot-elf-cm33-ironhide.bin; run _update_ipl_hf;
update_header=setenv flash_addr 0x34000000; tftp ${loadaddr} x5h_wb/u-boot-elf-cm33-ironhide-header.bin; run _update_ipl_hf;
update_loader=setenv loadaddr 0x60000000; run update_header; run update_uboot;

boot_ca0=scsi scan && rproc init; run _boot_scp && run _load_ca_ipl && run rsip_ipl_params_write && rproc load 13 ${rsip_ipl_tfa_ep} 4 && rproc start 13
_boot_scp=scsi read ${rsip_ipl_scp_ep} 0xd00 0x100 && rproc load 0 ${rsip_ipl_scp_ep} 0x60000 && rproc start 0
_load_ca_ipl=scsi read ${rsip_ipl_uboot_ep} 0x7200 0x100 && scsi read ${rsip_ipl_optee_ep} 0x5200 0x200 && scsi read ${rsip_ipl_tfa_ep} 0x5000 0x40
_load_linux=tftp 0x9e680000 Image-ironhide.bin && tftp 0x9e600000 x5h_wb/r8a780000-ironhide.dtb

resetenv=protect off 0x37F80000 +0x80000 && erase 0x37F80000 +0x80000

